# Copy this file to .env and adjust as needed. `docker compose up` reads this file.

# --- Postgres ---
POSTGRES_DB=life_controller
POSTGRES_USER=life_controller
POSTGRES_PASSWORD=life_controller
POSTGRES_PORT=5432

# --- Django backend ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://life_controller:life_controller@db:5432/life_controller
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# --- Redis / Celery ---
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- MinIO (S3-compatible media storage) ---
MINIO_ROOT_USER=life_controller
MINIO_ROOT_PASSWORD=life_controller_minio
MINIO_BUCKET=life-controller-media
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=localhost:9000/life-controller-media
MINIO_USE_SSL=False
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Next.js frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
